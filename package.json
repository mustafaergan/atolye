{
  "name": "atolye",
  "version": "0.3.2",
  "description": "Claude Agent SDK üzerinde çalışan, kurumsal gateway uyumlu yerel kodlama arayüzü",
  "main": "src/server.js",
  "type": "module",
  "bin": {
    "atolye": "src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "dev": "node --watch src/cli.js",
    "test": "node --experimental-test-module-mocks --test --test-force-exit test/permissions.test.mjs test/manager.test.mjs test/spend.test.mjs",
    "paket": "node scripts/paket.mjs",
    "paket:tam": "node scripts/paket.mjs --tam"
  },
  "engines": {
    "node": ">=18.18"
  },
  "keywords": [
    "claude",
    "agent-sdk",
    "coding-assistant",
    "web-ui"
  ],
  "author": "Mustafa Ergan",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.288",
    "dompurify": "^3.4.16",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "marked": "^18.0.14",
    "ws": "^8.22.0"
  }
}
