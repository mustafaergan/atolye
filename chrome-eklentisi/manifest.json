{
  "manifest_version": 3,
  "name": "Atölye",
  "short_name": "Atölye",
  "version": "1.1.0",
  "description": "Chrome'u bilgisayarınızdaki Atölye'ye bağlar: yapay zekâ yalnızca paylaştığınız sekmeleri okur, form doldurur, tıklar.",
  "homepage_url": "https://github.com/mustafaergan/atolye",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "arka-plan.js",
    "type": "module"
  },
  "action": {
    "default_title": "Atölye",
    "default_popup": "acilir.html",
    "default_icon": {
      "16": "simge/16.png",
      "32": "simge/32.png",
      "48": "simge/48.png"
    }
  },
  "icons": {
    "16": "simge/16.png",
    "32": "simge/32.png",
    "48": "simge/48.png",
    "128": "simge/128.png"
  }
}
