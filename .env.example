# Atölye ayarları — bu dosyayı ".env" olarak kopyalayıp doldurun.
# Not: Bu değerler ~/.claude/settings.json içinde "env" altında zaten tanımlıysa
# burada tekrar yazmanıza gerek yok; Atölye o dosyayı da okur.

# Şirket gateway adresi (claude /status çıktısındaki "Anthropic base URL")
ANTHROPIC_BASE_URL=https://sirket-gateway.example.com

# Gateway token'ı (Bearer). API anahtarı kullanıyorsanız ANTHROPIC_API_KEY yazın.
ANTHROPIC_AUTH_TOKEN=

# Kurumsal proxy ve sertifika gerekiyorsa
# HTTPS_PROXY=http://proxy.sirket.com:8080
# NODE_EXTRA_CA_CERTS=C:\\sertifikalar\\sirket-root-ca.pem

# Atölye
# ATOLYE_PORT=3210
# ATOLYE_CWD=C:\\projeler
# ATOLYE_NO_OPEN=1
# ATOLYE_DEBUG=1

# Harcama göstergesi (isteğe bağlı): harcama/bütçe bilgisini yazdıran bir komut.
# Çıktısının özeti üst çubukta "Bağlı" yazısının yanında görünür, tıklayınca tamamı açılır.
# ATOLYE_SPEND_CMD=node "C:\yol\scripts\spend.mjs"
