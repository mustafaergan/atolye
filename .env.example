# Atölye ayarları.
# Claude Code (claude) bu bilgisayarda zaten çalışıyorsa genelde bir şey yazmanız gerekmez:
# gateway adresi ve token ~/.claude/settings.json içindeki "env" bölümünden okunur.
# Orada yoksa aşağıdaki satırların başındaki "#" işaretini kaldırıp doldurun.

# Şirket gateway adresi (claude /status çıktısındaki "Anthropic base URL")
# ANTHROPIC_BASE_URL=https://sirket-gateway.example.com

# Gateway token'ı (Bearer). API anahtarı kullanıyorsanız ANTHROPIC_API_KEY yazın.
# ANTHROPIC_AUTH_TOKEN=

# Kurumsal proxy ve sertifika gerekiyorsa
# HTTPS_PROXY=http://proxy.sirket.com:8080
# NODE_EXTRA_CA_CERTS=C:\\sertifikalar\\sirket-root-ca.pem

# Atölye
# ATOLYE_PORT=3210
# ATOLYE_CWD=C:\\projeler
# ATOLYE_NO_OPEN=1
# ATOLYE_DEBUG=1

# Harcama göstergesi: gateway /spend-summary sunuyorsa kendiliğinden görünür.
# ATOLYE_SPEND=0
# ATOLYE_SPEND_PATH=/spend-summary
